# Copy to .env for local development. DATABASE_URL can instead live in the
# repo root's .env.local (written by `neon env pull`).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=
# The owner's admin login (made when the API starts). The email must end
# with @beautybayafrica.com; the password needs 8 or more characters.
ADMIN_EMAIL=hr@beautybayafrica.com
ADMIN_PASSWORD=
# Keeps everyone logged in across restarts; any long random text.
SESSION_SECRET=
# Pension and PAYE are set per employee in the app, not here.
# The website's address, for the links in contract and set-up emails.
SITE_URL=http://localhost:3100
# The email account the app sends from, by SMTP (Google Workspace, Zoho,
# Brevo, Resend...). Leave SMTP_HOST empty to keep emails in the outbox only
# (Settings → Emails sent). MAIL_FROM e.g. "Beauty Bay Africa HR <hr@beautybayafrica.com>"
SMTP_HOST=
SMTP_PORT=587   # 2525 on Render's free plan, which blocks 587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
