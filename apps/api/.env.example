# Copy to .env for local development. DATABASE_URL can instead live in the
# repo root's .env.local (written by `neon env pull`).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=
# The owner's admin login (made when the API starts). The email must end
# with @beautybayafrica.com; the password needs 8 or more characters.
ADMIN_EMAIL=hr@beautybayafrica.com
ADMIN_PASSWORD=
# Keeps everyone logged in across restarts; any long random text.
SESSION_SECRET=
# Pension and PAYE are set per employee in the app, not here.
